<view class="container">
  <view class="form-section">
    <view class="section-title">雪糕信息</view>
    
    <view class="form-item">
      <text class="label">雪糕名称 *</text>
      <input 
        class="input" 
        placeholder="请输入雪糕名称"
        value="{{name}}"
        bindinput="onInputChange"
        data-field="name"
        maxlength="50"
      />
    </view>

    <view class="form-item">
      <text class="label">雪糕规格 *</text>
      <input 
        class="input" 
        placeholder="如：10支/箱、500ml/瓶"
        value="{{spec}}"
        bindinput="onInputChange"
        data-field="spec"
        maxlength="30"
      />
    </view>

    <view class="form-item">
      <text class="label">雪糕分类</text>
      <picker mode="selector" range="{{categories}}" value="{{categoryIndex}}" bindchange="onCategoryChange">
        <view class="picker">{{category || '请选择分类'}}</view>
      </picker>
    </view>

    <view class="form-item">
      <text class="label">雪糕介绍</text>
      <textarea 
        class="textarea" 
        placeholder="请输入雪糕介绍"
        value="{{description}}"
        bindinput="onInputChange"
        data-field="description"
        maxlength="200"
        auto-height
      />
    </view>
  </view>

  <view class="form-section">
    <view class="section-title">
      雪糕图片 
      <text class="tip">(最多9张)</text>
    </view>
    
    <view class="image-list">
      <view 
        class="image-item" 
        wx:for="{{imageList}}" 
        wx:key="tempFilePath"
      >
        <image 
          class="preview-image" 
          src="{{item.tempFilePath}}"
          mode="aspectFill"
          bindtap="previewImage"
          data-url="{{item.tempFilePath}}"
        />
        <view class="delete-btn" bindtap="deleteImage" data-index="{{index}}">
          <text>×</text>
        </view>
      </view>
      
      <view class="add-image" wx:if="{{imageList.length < 9}}" bindtap="chooseImage">
        <text class="add-icon">+</text>
        <text class="add-text">添加图片</text>
      </view>
    </view>
  </view>

  <button 
    class="submit-btn {{submitting ? 'disabled' : ''}}" 
    bindtap="submitProduct"
    disabled="{{submitting}}"
  >
    {{submitting ? '发布中...' : '发布雪糕'}}
  </button>
</view>
