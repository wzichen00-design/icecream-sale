page {
  background-color: #f5f5f5;
}

.container {
  padding: 20rpx;
  padding-bottom: 40rpx;
}

.header {
  display: flex;
  align-items: baseline;
  justify-content: center;
  padding: 20rpx 0;
  margin-bottom: 15rpx;
  position: relative;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-right: 15rpx;
}

.subtitle {
  font-size: 24rpx;
  color: #999;
}

.settings-btn {
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  font-size: 36rpx;
  padding: 10rpx;
}

.search-bar {
  display: flex;
  gap: 15rpx;
  margin-bottom: 20rpx;
  align-items: center;
}

.search-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  background-color: #fff;
  border-radius: 50rpx;
  padding: 0 20rpx;
  height: 70rpx;
}

.search-icon {
  font-size: 28rpx;
  margin-right: 10rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
}

.clear-btn {
  font-size: 32rpx;
  color: #999;
  padding: 10rpx;
}

.category-filter {
  flex-shrink: 0;
}

.picker-btn {
  background-color: #fff;
  padding: 15rpx 25rpx;
  border-radius: 50rpx;
  font-size: 26rpx;
  color: #666;
}

.waterfall {
  display: flex;
  justify-content: space-between;
}

.waterfall-column {
  width: 48%;
}

.product-card {
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.product-image {
  width: 100%;
  min-height: 200rpx;
  background-color: #f5f5f5;
}

.product-info {
  padding: 20rpx;
}

.product-name {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-category {
  display: inline-block;
  font-size: 22rpx;
  color: #1890ff;
  background-color: #e6f7ff;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  margin-bottom: 10rpx;
}

.product-spec {
  display: block;
  font-size: 24rpx;
  color: #FF6B6B;
  margin-bottom: 10rpx;
}

.product-desc {
  display: block;
  font-size: 24rpx;
  color: #999;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.skeleton-container {
  padding: 0;
}

.skeleton-waterfall {
  display: flex;
  justify-content: space-between;
}

.skeleton-column {
  width: 48%;
}

.skeleton-card {
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  padding: 20rpx;
}

.skeleton-image {
  width: 100%;
  height: 200rpx;
  background-color: #f0f0f0;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

.skeleton-text {
  height: 30rpx;
  background-color: #f0f0f0;
  border-radius: 8rpx;
  margin-bottom: 15rpx;
}

.skeleton-text.short {
  width: 60%;
}

.skeleton-animate {
  animation: skeleton-loading 1.4s ease infinite;
}

@keyframes skeleton-loading {
  0% {
    opacity: 0.6;
  }
  50% {
    opacity: 1;
  }
  100% {
    opacity: 0.6;
  }
}

.empty {
  text-align: center;
  padding: 100rpx 40rpx;
}

.empty-icon {
  display: block;
  font-size: 100rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  display: block;
  font-size: 32rpx;
  color: #333;
  margin-bottom: 15rpx;
}

.empty-tip {
  display: block;
  font-size: 26rpx;
  color: #999;
}

.loading-more, .no-more {
  text-align: center;
  padding: 30rpx;
  color: #999;
  font-size: 26rpx;
}

.detail-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.6);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.detail-content {
  width: 90%;
  max-height: 80vh;
  background-color: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  position: relative;
}

.close-btn {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  width: 60rpx;
  height: 60rpx;
  background-color: rgba(0, 0, 0, 0.5);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}

.close-btn text {
  color: #fff;
  font-size: 40rpx;
  line-height: 1;
}

.detail-image {
  width: 100%;
  max-height: 500rpx;
  background-color: #f5f5f5;
}

.detail-single-image {
  width: 100%;
  background-color: #f5f5f5;
  display: flex;
  justify-content: center;
  padding: 20rpx 0;
}

.single-image {
  width: 90%;
  max-height: 600rpx;
  border-radius: 16rpx;
}

.detail-images-wrap {
  width: 100%;
  background-color: #f5f5f5;
  padding: 20rpx 0;
}

.detail-images {
  width: 100%;
  white-space: nowrap;
}

.images-scroll {
  display: inline-flex;
  padding: 0 20rpx;
}

.detail-images .detail-image {
  width: 280rpx;
  height: 280rpx;
  margin-right: 15rpx;
  flex-shrink: 0;
  border-radius: 12rpx;
}

.detail-images .detail-image:last-child {
  margin-right: 0;
}

.detail-info {
  padding: 30rpx;
}

.detail-name {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.detail-category {
  display: block;
  font-size: 26rpx;
  color: #1890ff;
  margin-bottom: 15rpx;
}

.detail-spec {
  display: block;
  font-size: 28rpx;
  color: #FF6B6B;
  margin-bottom: 15rpx;
}

.detail-desc {
  display: block;
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 20rpx;
}

.detail-time {
  font-size: 24rpx;
  color: #999;
}
